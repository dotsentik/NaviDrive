// Пример. Скопируйте в Config/Secrets.xcconfig и впишите свои значения (без кавычек).
GOOGLE_CLIENT_ID = 1234567890-abcdefghijklmnop.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET = GOCSPX-xxxxxxxxxxxxxxxxxxxxxxxx

// App key приложения Dropbox (dropbox.com/developers/apps → Settings → App key), без кавычек.
// Redirect URI в настройках приложения: http://127.0.0.1:53682/callback
DROPBOX_APP_KEY = abcdefghijklmno
