    "%@ couldn’t complete sign-in. Return to NaviDrive and try again.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ не завершил вход. Вернитесь в NaviDrive и попробуйте ещё раз."
