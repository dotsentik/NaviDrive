      }
    },
    "Access wasn’t granted. To use NaviDrive, allow access to Google Drive on the Google page.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Доступ не предоставлен. Чтобы пользоваться NaviDrive, разрешите доступ к Google Drive на странице Google."
