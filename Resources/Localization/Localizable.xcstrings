    "Back": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Назад"
          }
        }
      }
    },
    "By default NaviDrive uses the Google credentials built into this copy. Your own credentials take priority and are stored in the Keychain. Sign out to change this option.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "По умолчанию NaviDrive использует встроенные в эту копию учётные данные Google. Свои учётные данные имеют приоритет и хранятся в Связке ключей. Чтобы изменить параметр, выйдите из аккаунта."
          }
        }
      }
    },
