            "value": "Подсчёт…"
          }
        }
      }
    },
    "Create an OAuth Client ID of type “Desktop app” in Google Cloud Console and enable the Google Drive API. Keys and tokens are stored in the system Keychain.": {
      "localizations": {
        "ru": {
