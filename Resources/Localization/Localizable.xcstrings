        }
      }
    },
    "This copy of NaviDrive was built without Google sign-in credentials. Turn on “Use my own OAuth credentials” in Settings → Account → Advanced and enter your Client ID and Client Secret.": {
      "localizations": {
        "ru": {
          "stringUnit": {
